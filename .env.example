# .env.example
# ---------------------------------------------------------------------------
# Copia este fichero a `.env` y rellena los valores antes de `docker compose up`.
# El `.env` real está en .gitignore: no se sube nunca.
# ---------------------------------------------------------------------------

# --- Obligatorias en producción -------------------------------------------

# Con qué se firman los tokens. En producción el servidor NO arranca sin ella:
# un secreto de desarrollo conocido equivale a no tener firma.
# Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# La cuenta administradora inicial. Sin ADMIN_PASSWORD el sembrado se salta y
# te quedas sin poder entrar: una contraseña por defecto en un repositorio
# público es lo mismo que no tener contraseña.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=

# Credenciales de la base. Las usa el propio Mongo al crearse y la URI que
# arma el compose.
MONGO_USUARIO=educontrol
MONGO_PASSWORD=

# --- Con valor razonable, pero conviene revisarlas -------------------------

DB_NAME=educontrol

# Cuánto dura una sesión.
JWT_EXPIRES_IN=12h

# Sin esto, nadie puede darse de alta como profesor: el rol se queda en
# estudiante y no hay forma de ascender salvo que lo haga un administrador.
PROFESOR_CLAVE=

# Puerto que se publica en la máquina anfitriona.
PUERTO_PUBLICO=3000

# Cuántos proxies hay DELANTE de la aplicación. Este compose publica el puerto
# directamente, así que no hay ninguno: 0. Si pones un nginx o un balanceador
# por delante, súbelo a 1 — si no, `req.ip` será la IP del proxy para TODAS las
# peticiones y los frenos por IP dejarán de distinguir a nadie.
#
# Un número de saltos y nunca `true`: con `true` Express se cree la cabecera
# X-Forwarded-For entera, y esa la pone quien quiera.
TRUST_PROXY=0
