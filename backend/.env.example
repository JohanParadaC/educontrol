# Puerto en que corre el servidor
PORT=

# URI de MongoDB en Atlas o local
MONGO_URI=

# Clave para firmar JWT
JWT_SECRET=

# Duración del token de sesión, en el formato de jsonwebtoken ('12h', '30m',
# '7d'...). Si se deja vacía, 12h. Es el único sitio donde se decide: la firma
# vive entera en utils/jwt.js.
JWT_EXPIRES_IN=

# Clave que se exige para registrarse o ascender a rol "profesor".
# Si se deja vacía, nadie puede auto-asignarse el rol: solo un admin lo concede.
PROFESOR_CLAVE=

# Admin inicial que crea el servidor al arrancar (app.js -> ensureAdminSeed).
# Es la única vía de crear un admin en producción: /api/admin/seed-admin y
# /api/admin/purge solo existen cuando NODE_ENV es 'development' o 'test'.
ADMIN_EMAIL=
ADMIN_PASSWORD=
