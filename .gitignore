# Dependencias
node_modules/

# Builds
dist/
tmp/
out-tsc/

# Cobertura de tests
coverage/
*.lcov
.nyc_output/

# Variables de entorno (nunca subir secretos)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Perfil temporal de Chrome que usa scripts/capturas.mjs
.chrome-capturas/

